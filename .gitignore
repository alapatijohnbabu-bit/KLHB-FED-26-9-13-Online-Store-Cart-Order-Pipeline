# Java compiled output (never commit .class files)
*.class
trash/*
!trash/.gitkeep
out/
bin/
target/
build/

# IDE settings
.idea/
*.iml
.vscode/*
!.vscode/launch.json
!.vscode/settings.json
.project
.classpath
.settings/

# Logs and temporary files
*.log
hs_err_pid*
replay_pid*
.DS_Store
Thumbs.db

# Archives and packaged binaries
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
